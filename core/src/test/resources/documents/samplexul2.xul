<?xml-stylesheet href="chrome://global/skin/" type="text/css"?>
<window   id="label-test" title="Testing Nick's Sample"
	width="300" height="200"
	xmlns="http://www.pentaho.org/there.is.only.xul">
	
	<script id="handler" src="org.pentaho.ui.xul.samples.ButtonTest"/>
	
	<vbox id="vbox1">
		<hbox>
			<label id="namelabel" value="What is your name?"/>
			<textbox id="name" value=""/>
		</hbox>
		<button id="button1" label="${hello}" onclick="handler.sayHi()"/>
		<label id="response" value="" />
	</vbox>
</window>
